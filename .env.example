# Use STAGING / TEST values locally. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # publishable key
SUPABASE_SERVICE_ROLE_KEY=        # secret key (server only)

# ---- AI provider (pick ONE block) ----
# FREE (Google Gemini via AI Studio):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
# PAID (OpenAI): leave OPENAI_BASE_URL empty and set OPENAI_MODEL=gpt-4o-mini

# ---- Speech to text (the Lecture Transcripts tool) ----
# OpenAI: leave as whisper-1 (or gpt-4o-mini-transcribe) and it works.
# Gemini: there is no /audio/transcriptions endpoint, so the tool falls back to
# sending the audio to OPENAI_AUDIO_MODEL as a chat message instead.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_AUDIO_MODEL=                # optional; defaults to OPENAI_MODEL
TRANSCRIBE_MAX_BYTES=12582912      # 12 MB. Raise only if your host allows long requests.

AI_DISABLED=0                     # set to 1 to switch every AI feature off instantly

DEMO_CHECKOUT=0                   # 1 = fake checkout, no payment taken. NEVER leave this on in production.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
